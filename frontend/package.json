{
  "name": "community-prediction-frontend",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build --config vite.standalone.config.ts && node scripts/write-standalone-html.mjs",
    "build:embed": "tsc -b && vite build --config vite.lib.config.ts",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.19.1"
  }
}
